#!/usr/bin/env bash
# shellcheck shell=bash
#
# Git pre-push hook for gaudi-shell
# Runs pre-commit lint checks and tests before pushing.

# The repository being pushed, not whichever copy happens to be installed.
if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z "$REPO_ROOT" ]]; then
	echo "pre-push: not inside a git work tree. Push aborted."
	exit 1
fi
cd "$REPO_ROOT" || exit 1

# Run pre-commit checks if available
if command -v pre-commit &>/dev/null; then
	echo "Running pre-commit checks before push..."
	pre-commit run --all-files || {
		echo "Pre-commit checks failed. Push aborted."
		exit 1
	}
fi

# Run tests if a test runner is available. Standard input is closed for them:
# git feeds the hook the list of refs being pushed.
if [[ -x "${REPO_ROOT}/test/run" ]]; then
	echo "Running tests before push..."
	"${REPO_ROOT}/test/run" </dev/null || {
		echo "Tests failed. Push aborted."
		exit 1
	}
fi

exit 0
