[submodule "bin/bats-core"]
	path = bin/bats-core
	url = https://github.com/bats-core/bats-core.git
[submodule "bin/bats-support"]
	path = bin/bats-support
	url = https://github.com/bats-core/bats-support.git
[submodule "bin/bats-assert"]
	path = bin/bats-assert
	url = https://github.com/bats-core/bats-assert.git
[submodule "bin/bats-file"]
	path = bin/bats-file
	url = https://github.com/bats-core/bats-file.git
[submodule "components/aliases"]
	path = components/aliases
	url = https://github.com/g-udi/gaudi-bash-aliases
[submodule "components/completions"]
	path = components/completions
	url = https://github.com/g-udi/gaudi-bash-completions
[submodule "components/plugins"]
	path = components/plugins
	url = https://github.com/g-udi/gaudi-bash-plugins
