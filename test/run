#!/usr/bin/env bash
# shellcheck shell=bash

GAUDI_TEST_DIRECTORY="$(cd "$(dirname "$0")" && pwd)"

export GAUDI_SHELL_ORIGIN="${GAUDI_TEST_DIRECTORY%/*}"
export GAUDI_BATS="${GAUDI_SHELL_ORIGIN}/bin/bats-core/bin/bats"
export GAUDI_TEST_DEPS_DIR="${GAUDI_SHELL_ORIGIN}/bin"
export GAUDI_TEST_DIRECTORY

case $OSTYPE in
darwin*)
	export GAUDI_SHELL_PROFILE=".bash_profile"
	;;
*)
	export GAUDI_SHELL_PROFILE=".bashrc"
	;;
esac

# The tests work on a copy of this checkout, shared components included: the
# component submodules have to be there (the tests never use the network).
for submodule in components/aliases components/completions components/plugins; do
	if [[ ! -d "${GAUDI_SHELL_ORIGIN}/${submodule}/lib" ]]; then
		echo "The shared components are missing (${submodule}). Fetch them first:" >&2
		echo "  git submodule update --init components/aliases components/completions components/plugins" >&2
		exit 1
	fi
done

echo -e "\nRunning gaudi-shell tests...\n"

# Find all .bats files (bash 3.x compatible — no globstar or mapfile needed)
test_dirs=()
while IFS= read -r f; do
	test_dirs+=("$f")
done < <(find "${GAUDI_TEST_DIRECTORY}" -name '*.bats' -type f | sort)

exec "$GAUDI_BATS" ${CI:+--tap} "${test_dirs[@]}"
